# Copia este fichero como .env (NO se versiona) y rellena los valores reales.

# Clave personal de AEMET OpenData (https://opendata.aemet.es/centrodedescargas/altaUsuario)
AEMET_API_KEY=pon_aqui_tu_clave_de_aemet

# Contraseña del usuario "admin" de NiFi (mínimo 12 caracteres). La usa docker-compose.yml
NIFI_PASSWORD=minimo_12_caracteres
